.vscode/**
.vscode-test.mjs
.vscode-test/**
.scratch/**
.claude/**
.github/**
.autodev/**
# The shop overlay is process config for building this extension, not part of it.
autodev/**
kb/**
src/**
test/**
# The compiled test BUNDLES too — `test/**` only excludes the sources, so without this
# the .vsix ships every test suite to every user (~250 KB of it after T-4's). Nothing in
# `dist/test/` is reachable from `main`; it exists for `.vscode-test.mjs`, which reads it
# out of the working tree and never out of the package.
dist/test/**
scripts/**
esbuild.mjs
eslint.config.mjs
tsconfig.json
.gitignore
**/*.ts
**/*.map

# ── T-8: the packaging intermediates ────────────────────────────────────────────────────
# `vendor/` holds the repo-tour tarball `scripts/package.mjs` packs, and `.package-staging/`
# is the staging copy it installs that tarball into. Both exist only while a package is being
# built, and neither belongs in the archive.
vendor/**
.package-staging/**
# Release tooling for THIS repository rather than part of the extension: the packaging and
# publish decision logic that scripts/package.mjs and scripts/publish.mjs import.
dist/publish.js

# ── T-40: VS Code's own icon font (@vscode/codicons) ─────────────────────────────────────
# The webviews load two of the package's ~700 files, its stylesheet and the font that sheet
# names, and both of its licences travel with them: CC-BY-4.0 for the icons and MIT for the
# stylesheet each ask for that. Its package.json stays so the folder is still a package.
# Everything else (the SVG sources, a 1.4 MB preview page, its build scripts and CI) stays
# out. A `!` line re-includes a file the line above it excluded; scripts/package.mjs reads the
# archive back and fails if any of the four is missing (src/publish/disclosure.ts).
node_modules/@vscode/codicons/**
!node_modules/@vscode/codicons/package.json
!node_modules/@vscode/codicons/LICENSE
!node_modules/@vscode/codicons/LICENSE-CODE
!node_modules/@vscode/codicons/dist/codicon.css
!node_modules/@vscode/codicons/dist/codicon.ttf
#
# WHAT MUST NEVER BE ADDED TO THIS FILE: `node_modules/**`.
#
# The staged package's entire purpose is that `node_modules/repo-tour` — plus web-tree-sitter
# and tree-sitter-wasms, with their .wasm grammars — travels INSIDE the .vsix. Excluding it
# would silently restore the bug T-8 exists to fix: the extension installs, activates, looks
# perfectly healthy, and then reports "core NOT found" because the core it was built to load
# is on somebody else's machine. There is no test that catches that here; the check lives in
# scripts/package.mjs, which reads the finished archive back and fails if the core is absent.

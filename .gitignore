node_modules/
# Without this second line a node_modules SYMLINK slips past — `node_modules/` matches a
# DIRECTORY only, and a worktree sharing deps via `ln -s` therefore commits a link that, once
# merged back, replaces the real directory with one pointing at itself. Happened on T-15.
node_modules
dist/
out/
*.vsix

# T-8 packaging intermediates: the packed repo-tour tarball and the staging copy it is
# installed into. Both are rebuilt from scratch by every `npm run package`.
vendor/
.package-staging/
*.log
.cache/
.scratch/
.vscode-test/

# factory ledger and generated day pages stay local (public repo, owner's request 2026-09-05)
.autodev/
kb/days/
